# ===== автотесты Kovapp (веб-версия, Android и ПК): F:\kovapp_autotest =====
# Файл лежит в F:\kovapp_autotest под именем .env
# Пароли ниже — только для тестовой базы внутри Docker, к рабочему серверу отношения не имеют.

# ===== режим по умолчанию =====
RUN_MODE=full
TARGET=web

# ===== варианты приложения: свои папки внутри project =====
# веб-версия: сервер для всех прогонов и сайт для браузеров (внутри server\ и web_app\)
PROJECT_WEB_DIR=./project/web
# Android: из этой папки собирается APK (внутри mobile\ и web_app\); обычно тот же архив проекта
PROJECT_ANDROID_DIR=./project/android
# ПК-версия (программа для Windows, внутри main.py и kov\): проверка — run.cmd pc, без Docker
PROJECT_PC_DIR=./project/pc
# PROJECT_DIR=./project — прежняя общая папка: если указана, а две строки выше нет, берётся для обеих

# ===== сервер и база внутри Docker (run.cmd, run.cmd mobile, run.cmd device) =====
FULL_ADMIN_LOGIN=admin
FULL_ADMIN_PASSWORD=Admin-Autotest-2026
FULL_ACCOUNT_PASSWORD=Autotest-2026!
FULL_JWT_SECRET=autotest-jwt-secret-change-me-0123456789abcdef
FULL_FILE_ACCESS_STRICT=1
FULL_PROJECT_ACCESS_MODE=open
FULL_PUBLISH_PORT=18000
DB_ROOT_PASSWORD=autotest-root-2026
# split — API, переписка, чтение и приём загрузок в отдельных процессах за nginx (как на рабочем сервере); all — один процесс
FULL_SERVER_ROLE=split
# журнал долгих шагов сервера, мс (0 — выключен)
LOOP_SLOW_MS=0

# ===== свой сервер вне Docker (run.cmd external) — по умолчанию сервер на этом ПК =====
# Рабочий сервер сюда не ставьте: тесты создают и удаляют тестовые данные.
EXTERNAL_BASE_URL=http://host.docker.internal:54545
EXTERNAL_ADMIN_LOGIN=admin
EXTERNAL_ADMIN_PASSWORD=
EXTERNAL_CONFIRM_TEST_SERVER=1
EXTERNAL_CREATE_ACCOUNTS=1
EXTERNAL_ACCOUNT_PASSWORD=Autotest-External-2026!
EXTERNAL_CLEANUP=1
EXTERNAL_FILE_ACCESS_STRICT=auto
APP_PATH=/app/

# ===== браузеры (сайт) =====
BROWSERS=chrome,firefox,webkit
MOBILE_DEVICE_WEBKIT=iPhone 13
TREAT_AS_SECURE=1
HEADLESS=1
DESKTOP_VIEWPORT=1440x900
MOBILE_DEVICE=Pixel 7
THEMES=light,dark
DEVICES=desktop,mobile
TIMEOUT_MS=15000
SLOW_MO_MS=0
RECORD_VIDEO=0

# ===== скорость =====
PARALLEL=1

# ===== что проверять =====
SECTIONS=all
LAYERS=api,ui,visual,realtime
VISUAL_ROLES=
CRAWLER_ROLES=
REALTIME_TIMEOUT_S=12
NETWORK_SHORT_OUTAGE_S=6
NETWORK_LONG_OUTAGE_S=90
NETWORK_UPLOAD_DELAY_MS=1200
NETWORK_FILE_MB=40
NETWORK_OFFLINE_EXPECT=resume
NETWORK_OFFLINE_GRACE_S=120
PUSH_DEVICE_LOGIN=
PUSH_DEVICE_PASSWORD=
PUSH_DEVICE_WAIT_S=60
TOUCH_MIN_PX=24
TOUCH_WARN_PX=40

# ===== Android на ПК: интерфейс APK (run.cmd android-pc) =====
APK_DEVICES=mobile,small,tablet
APK_PHONE=Pixel 7
APK_SMALL=Galaxy S9+
APK_TABLET=Galaxy Tab S4
APK_WIDE=Galaxy Tab S4 landscape
APK_LAYERS=ui,visual,realtime,mobile
APK_VISUAL_TOLERANCE=2
APK_VISUAL_MAX_PIXELS=200
APK_PUSH_WAIT_S=20
APK_INSECURE_UPSTREAM=0

# ===== Android на эмуляторе или телефоне (run.cmd android-device): Appium и всё остальное — в Docker =====
# Папка Android SDK (как в Android Studio: Settings → Android SDK)
ANDROID_SDK=F:\Android\Sdk
# Имя эмулятора из Android Studio (пусто — первый созданный)
DEVICE_AVD=
# Эмулятор без сервисов Google (как Huawei) для run.cmd device-both
DEVICE_AVD_NOGMS=
# Второй телефон для run.cmd device-pair (пусто — DEVICE_AVD_NOGMS) и его память, МБ
DEVICE_AVD2=
DEVICE2_MEMORY_MB=2048
# Память эмулятора, МБ (меньше — легче для ПК; по умолчанию 3072)
DEVICE_MEMORY_MB=3072
# 1 — не закрывать эмулятор после прогона (по умолчанию закрывается)
DEVICE_KEEP_EMULATOR=0
# Порт сервера для приложения на телефоне (менять не нужно)
DEVICE_PORT=8000
DEVICE_LAYERS=device

# ===== нагрузка по ступеням (run.cmd load): сервер размером с рабочий =====
LOAD_SERVER_CPUS=2
LOAD_SERVER_MEMORY=1400m
LOAD_DB_CPUS=0.5
LOAD_DB_MEMORY=512m
LOAD_LAYERS=api
LOAD_SECTIONS=files,device,messenger,realtime,load
# больше всего людей — первая ступень; меньше всего — последняя
LOAD_USERS=50
LOAD_USERS_MIN=2
# ступени через запятую; пусто — 50, 40, 30, 20, 10, 5, 2 (от LOAD_USERS до LOAD_USERS_MIN)
LOAD_STEPS=
# на каждой ступени: разгон и замер, с; пауза между ступенями — пока сервер не успокоится (не дольше LOAD_COOLDOWN_S)
LOAD_WARMUP_S=30
LOAD_STEP_S=180
LOAD_COOLDOWN_S=60
# доля людей «с телефоном»: у них ещё одно соединение — канал уведомлений приложения /ws/native-push
LOAD_PHONE_PERCENT=30
# живой браузер (Chromium) открывает страницы на каждой ступени — время глазами человека
LOAD_BROWSER_PROBE=1
LOAD_CHAT_SECONDS=60
LOAD_FILES_PER_USER=2
LOAD_RAW_PERCENT=10
# пороги — проверяются на самой большой ступени (95% операций должны уложиться)
LOAD_CHAT_P95_MS=1500
LOAD_UPLOAD_P95_S=45
LOAD_SMALL_P95_S=5
LOAD_VIDEO_P95_S=20
LOAD_API_P95_MS=2500
LOAD_CONNECT_P95_MS=3000
LOAD_PAGE_P95_MS=4000
LOAD_LOOP_LAG_P95_MS=500
LOAD_RAM_MIN_FREE_PERCENT=10

# ===== качество сжатия (run.cmd compression) =====
# где сжимать: браузеры — из BROWSERS, сервер, телефон (эмулятор, если есть Android SDK),
# ПК-версия (auto — если она лежит в project\pc; 0 — не включать)
CMP_BROWSERS=chrome,firefox,webkit
CMP_SERVER=1
CMP_PHONE=auto
CMP_PC=auto
# допуски: результаты разных мест сравниваются между собой, а не с оригиналом
# фото: стороны — точно; сходство с оригиналом (SSIM) — разница не больше; размер файла — разница не больше, %
CMP_PHOTO_SSIM_DIFF=0.02
CMP_PHOTO_SIZE_DIFF=25
# видео: разрешение и частота кадров — точно; длительность — до 0,1 с; SSIM и размер — как у фото
CMP_VIDEO_DURATION_S=0.1
CMP_VIDEO_SSIM_DIFF=0.03
CMP_VIDEO_SIZE_DIFF=40
# документы: после распаковки — байт в байт; размер сжатого — разница не больше, %
CMP_DOC_SIZE_DIFF=2

# ===== журналы =====
KEEP_RUNS=30
SCREENSHOTS=all
RUN_LABEL=

# ===== DNS контейнеров (доступ к Google и репозиториям) =====
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8
